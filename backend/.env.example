# SAQSHY AIR Backend Configuration
# Copy this file to .env and fill in your values

# Groq API Key (for AI Assistant - uses Qwen 3.8-27B via Groq Cloud)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key (alternative, not used by default)
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=sqlite:///./saqshy.db

# Demo Mode (true = simulated sensor data)
DEMO_MODE=true
